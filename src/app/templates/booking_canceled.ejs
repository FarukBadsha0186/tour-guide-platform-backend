<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Booking Cancellation</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f7f7f7;
        color: #333;
        margin: 0;
        padding: 0;
      }
      .container {
        max-width: 600px;
        margin: 40px auto;
        background: #fff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      }
      .header {
        text-align: center;
        border-bottom: 2px solid #dc3545;
        padding-bottom: 20px;
        margin-bottom: 20px;
      }
      .header h1 {
        color: #dc3545;
        font-size: 24px;
        margin: 0;
      }
      .header h2 {
        color: #dc3545;
        font-size: 18px;
        margin: 10px 0 0 0;
      }
      .content p {
        font-size: 15px;
        line-height: 1.6;
        color: #333;
      }
      .details {
        background: #fff5f5;
        padding: 20px;
        border-radius: 6px;
        margin: 20px 0;
        border-left: 4px solid #dc3545;
      }
      .details-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #ccc;
        font-size: 14px;
      }
      .details-row:last-child {
        border-bottom: none;
      }
      .details-row strong {
        color: #555;
      }
      .refund-notice {
        background: #d4edda;
        border-left: 4px solid #28a745;
        padding: 15px;
        border-radius: 4px;
        margin: 20px 0;
        font-size: 14px;
      }
      .footer {
        margin-top: 30px;
        font-size: 12px;
        color: #888;
        text-align: center;
        border-top: 1px solid #eee;
        padding-top: 20px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Tour Guide Platform</h1>
        <h2>✗ Booking Cancellation</h2>
      </div>

      <div class="content">
        <p>Hello <strong><%= touristName %></strong>,</p>
        <p>
          We're sorry to inform you that your booking has been
          <strong>cancelled by the guide</strong>. Please find the details below.
        </p>

        <div class="details">
          <div class="details-row">
            <strong>Booking Reference:</strong>
            <span><%= bookingReference %></span>
          </div>
          <div class="details-row">
            <strong>Tour Date:</strong>
            <span><%= tourDate %></span>
          </div>
          <div class="details-row">
            <strong>Number of People:</strong>
            <span><%= numberOfPeople %></span>
          </div>
          <div class="details-row">
            <strong>Cancellation Reason:</strong>
            <span><%= cancellationReason %></span>
          </div>
          <div class="details-row">
            <strong>Status:</strong>
            <span style="color: #dc3545; font-weight: bold;">CANCELLED</span>
          </div>
        </div>

        <div class="refund-notice">
          <strong>💰 Refund Info:</strong><br />
          Amount: <strong><%= refundAmount %></strong><br />
          Your refund will be processed within <strong>5-7 business days</strong>.
        </div>

        <p>We apologize for the inconvenience.</p>
      </div>

      <div class="footer">
        &copy; Tour Guide Platform. All rights reserved.
      </div>
    </div>
  </body>
</html>